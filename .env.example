# ── Minecraft server (cracked / offline-mode) ─────────────────────────
MC_HOST=127.0.0.1
MC_PORT=25565
# Leave blank to auto-detect the server version. Set it if auto-detect fails.
MC_VERSION=
BOT_USERNAME=Trisha
# offline = cracked server. Do not change unless your server is online-mode.
MC_AUTH=offline

# Your in-game name. Trisha treats this player as her owner: she obeys,
# follows and protects them above everything else.
OWNER=YourNameHere
# Extra players she should listen to (comma separated, optional)
FRIENDS=

# ── LLM brain (ZenAPI, OpenAI-compatible) ─────────────────────────────
ZEN_BASE_URL=https://zendigikey.shop/v1
ZEN_API_KEY=sk-replace-me

# Fast tier: runs the moment-to-moment decision loop (called often, keep cheap)
MODEL_FAST=claude-haiku-4-5
# Smart tier: real planning, hard tasks, recovering from repeated failure
MODEL_SMART=claude-opus-4.8
# Chat tier: replying to you in-game with personality
MODEL_CHAT=claude-haiku-4-5

# ── Brain tuning ──────────────────────────────────────────────────────
# ms between autonomous decisions when idle
THINK_INTERVAL_MS=6000
# hard timeout on any single LLM call
LLM_TIMEOUT_MS=20000
# ── Autonomy ──────────────────────────────────────────────────────────
#
# Both default to FALSE, deliberately.
#
# With them off she does exactly what you tell her and nothing else, while her
# reflexes still keep her alive: eating, creeper dodges, clutches, fighting back.
# That part is reliable and well tested.
#
# With them on she runs a 25-rung survival ladder and makes her own decisions. That
# part is NOT reliable yet — it needs hours of unattended soak testing, and it will
# wander and stall in ways that look silly. Turn it on when you have patience for
# that, not when you want a dependable companion.
AUTONOMY=false
LADDER_ON_SPAWN=false
# log every brain decision to console
VERBOSE=true
