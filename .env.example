# ── Minecraft server (cracked / offline-mode) ─────────────────────────
MC_HOST=127.0.0.1
MC_PORT=25565
# Leave blank to auto-detect the server version. Set it if auto-detect fails.
MC_VERSION=1.21.4
BOT_USERNAME=Trisha
# offline = cracked server. Do not change unless your server is online-mode.
MC_AUTH=offline

# Your in-game name. Trisha treats this player as her owner: she obeys,
# follows and protects them above everything else.
OWNER=YourNameHere
# Extra players she should listen to (comma separated, optional)
FRIENDS=

# ── LLM brain (OpenAI-compatible relay) ───────────────────────────────
LLM_BASE_URL=http://54.204.234.44:3000/v1
LLM_API_KEY=sk-replace-me

# Model names are NOT stable on this relay — run `npm run probe` to see what is live.
# Fast tier: the moment-to-moment decision loop (called often, keep it cheap)
MODEL_FAST=gpt-5.4-mini
# Smart tier: real planning, and recovering from a rung that keeps failing
MODEL_SMART=claude-opus-5
# Chat tier: replying to you in-game with personality
MODEL_CHAT=gpt-5.4-mini
# Planner tier: the one expensive think that surveys the area and builds a plan
MODEL_PLANNER=claude-sonnet-5
# Optional comma-separated fallbacks used when a tier's primary model is down
MODEL_FAST_FALLBACKS=gpt-5.6-terra,gpt-5.6-luna,qwen3-coder-next
MODEL_SMART_FALLBACKS=claude-sonnet-5,claude-opus-4.8,gpt-5.6-sol

# ── Brain tuning ──────────────────────────────────────────────────────
# ms between autonomous decisions when idle
THINK_INTERVAL_MS=6000
# hard timeout on any single LLM call
LLM_TIMEOUT_MS=20000

# ── Autonomy ──────────────────────────────────────────────────────────
#
# Both must be true for her to run the survival ladder on her own. With them off she
# does only what you tell her, while her reflexes still keep her alive: eating, creeper
# dodges, clutches, fighting back.
#
# With them on she works a predicate ladder from an empty inventory upward. The early
# chain (wood, stone kit, food, mining kit, iron) is measured and reliable; the final
# smelt-craft-equip stretch is still being hardened.
AUTONOMY=true
LADDER_ON_SPAWN=true
# log every brain decision to console
VERBOSE=true

# ── Mining ────────────────────────────────────────────────────────────
# How far to look for ore before falling back to blind tunnelling. The server already
# streams her every block in the loaded chunks, so searching wide and walking to a real
# seam is far faster and safer than digging on spec — a whole trip once returned zero ore
# from hundreds of blocks of straight tunnel. Lower this for more human-like prospecting.
ORE_SCAN_RADIUS=64
# Y level she branch mines for iron at
IRON_Y=16
# Y level for the diamond trip
DIAMOND_Y=-54

# ── Survival thresholds ───────────────────────────────────────────────
# health at or below which she breaks off and heads for safety
HOME_HP=8
# inventory fullness (0-1) that sends her home to deposit
HOME_INV_FULL=0.85
# self_defence = fight back and defend the owner only. free = duel anyone.
PVP_MODE=self_defence

# ── Live viewer ───────────────────────────────────────────────────────
# Set a port to serve a browser view of what she is doing, then open
# http://<host>:<port>. Needs the native `canvas` package, which needs build tools:
#   sudo apt-get install -y build-essential pkg-config libcairo2-dev libpango1.0-dev \
#     libjpeg-dev libgif-dev librsvg2-dev
#   npm install canvas
# Leave blank to disable. A viewer failure is logged and otherwise ignored — watching
# her can never take the bot down.
VIEWER_PORT=
VIEWER_FIRST_PERSON=false

# ── Diagnostics ───────────────────────────────────────────────────────
# Where she writes abort-safe evidence: status.json, status.txt and an append-only
# timeline.log, flushed every 10s and again on exit. Defaults to ./memory.
# A long run is usually killed rather than allowed to finish, and without this the
# result dies with the process.
STATUS_DIR=
